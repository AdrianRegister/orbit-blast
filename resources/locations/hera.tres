[resource]
script = ExtResource("1")
id = &"hera"
display_name = "Hera"
faction = ExtResource("faction_1")
population = 3200000
planet_type = ExtResource("2")
exported_goods = Array[ExtResource("cs")]([ExtResource("c_ore"), ExtResource("c_fuel")])
imported_goods = Array[ExtResource("cs")]([ExtResource("c_food")])
size = 520.0
outfitter_upgrades = Array[ExtResource("uds")]([ExtResource("up_cargo_bay"), ExtResource("up_engine_1"), ExtResource("up_engine_2")])
outfitter_weapons = Array[ExtResource("wds")]([ExtResource("w_light_blaster"), ExtResource("w_ion_repeater")])
