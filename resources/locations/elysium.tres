[gd_resource type="Resource" script_class="PlanetData" format=3]

[ext_resource type="Script" path="res://scripts/resources/planet_data.gd" id="1"]
[ext_resource type="Resource" path="res://resources/planet_types/arctic.tres" id="2"]
[ext_resource type="Script" path="res://scripts/resources/commodity.gd" id="cs"]
[ext_resource type="Resource" path="res://resources/commodities/electronics.tres" id="c_electronics"]
[ext_resource type="Resource" path="res://resources/commodities/fuel.tres" id="c_fuel"]
[ext_resource type="Resource" path="res://resources/commodities/ore.tres" id="c_ore"]
[ext_resource type="Script" path="res://scripts/resources/ship_stats.gd" id="sss"]
[ext_resource type="Resource" path="res://resources/ships/interceptor_stats.tres" id="sy_interceptor"]
[ext_resource type="Resource" path="res://resources/ships/light_frigate_stats.tres" id="sy_light_frigate"]
[ext_resource type="Script" path="res://scripts/resources/upgrade_definition.gd" id="uds"]
[ext_resource type="Resource" path="res://resources/upgrades/cargo_bay.tres" id="up_cargo_bay"]
[ext_resource type="Resource" path="res://resources/upgrades/engine_1.tres" id="up_engine_1"]

[resource]
script = ExtResource("1")
id = &"elysium"
display_name = "Elysium"
faction_name = "TestFaction_1"
population = 7800000
planet_type = ExtResource("2")
exported_goods = Array[ExtResource("cs")]([ExtResource("c_electronics")])
imported_goods = Array[ExtResource("cs")]([ExtResource("c_ore"), ExtResource("c_fuel")])
size = 580.0
shipyard_ships = Array[ExtResource("sss")]([ExtResource("sy_interceptor"), ExtResource("sy_light_frigate")])
outfitter_upgrades = Array[ExtResource("uds")]([ExtResource("up_cargo_bay"), ExtResource("up_engine_1")])
