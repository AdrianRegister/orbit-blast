[ext_resource type="Resource" path="res://resources/contracts/persephone_medical_to_daedalus.tres" id="o_persephone_medical_to_daedalus"]

[resource]
script = ExtResource("1")
id = &"persephone"
display_name = "Persephone"
faction_name = "TestFaction_1"
population = 5100000
planet_type = ExtResource("2")
exported_goods = Array[ExtResource("cs")]([ExtResource("c_electronics"), ExtResource("c_ore")])
imported_goods = Array[ExtResource("cs")]([ExtResource("c_fuel"), ExtResource("c_machinery")])
size = 560.0
shipyard_ships = Array[ExtResource("sss")]([ExtResource("sy_shuttle"), ExtResource("sy_interceptor"), ExtResource("sy_freighter"), ExtResource("sy_bulk_freighter"), ExtResource("sy_light_frigate")])
outfitter_upgrades = Array[ExtResource("uds")]([ExtResource("up_cargo_bay"), ExtResource("up_engine_1"), ExtResource("up_engine_2"), ExtResource("up_engine_3"), ExtResource("up_manoeuvre_1"), ExtResource("up_manoeuvre_2")])
contract_offers = Array[ExtResource("cos")]([ExtResource("o_persephone_medical_to_daedalus")])
