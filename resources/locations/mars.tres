[gd_resource type="Resource" script_class="PlanetData" format=3]

[ext_resource type="Script" path="res://scripts/resources/planet_data.gd" id="1"]
[ext_resource type="Resource" path="res://resources/planet_types/rocky.tres" id="2"]
[ext_resource type="Resource" path="res://resources/commodities/ore.tres" id="c_ore"]
[ext_resource type="Resource" path="res://resources/commodities/food.tres" id="c_food"]
[ext_resource type="Resource" path="res://resources/commodities/fuel.tres" id="c_fuel"]
[ext_resource type="Resource" path="res://resources/commodities/rare_isotopes.tres" id="c_rare_isotopes"]
[ext_resource type="Resource" path="res://resources/commodities/water.tres" id="c_water"]
[ext_resource type="Resource" path="res://resources/commodities/medical_supplies.tres" id="c_medical_supplies"]
[ext_resource type="Resource" path="res://resources/commodities/luxury_goods.tres" id="c_luxury_goods"]
[ext_resource type="Script" path="res://scripts/resources/commodity.gd" id="cs"]
[ext_resource type="Script" path="res://scripts/resources/upgrade_definition.gd" id="uds"]
[ext_resource type="Resource" path="res://resources/upgrades/cargo_bay.tres" id="up_cargo_bay"]
[ext_resource type="Resource" path="res://resources/upgrades/engine_1.tres" id="up_engine_1"]
[ext_resource type="Resource" path="res://resources/upgrades/engine_2.tres" id="up_engine_2"]
[ext_resource type="Resource" path="res://resources/upgrades/engine_3.tres" id="up_engine_3"]
[ext_resource type="Resource" path="res://resources/factions/federation.tres" id="faction_1"]

[ext_resource type="Resource" path="res://resources/economy/profiles/industrial.tres" id="profile"]
[ext_resource type="Script" path="res://scripts/resources/weapon_definition.gd" id="wds"]
[ext_resource type="Resource" path="res://resources/weapons/light_blaster.tres" id="w_light_blaster"]
[ext_resource type="Resource" path="res://resources/weapons/ion_repeater.tres" id="w_ion_repeater"]
[ext_resource type="Resource" path="res://resources/weapons/pulse_cannon.tres" id="w_pulse_cannon"]

[resource]
script = ExtResource("1")
id = &"mars"
planet_type = ExtResource("2")
display_name = "Mars"
faction = ExtResource("faction_1")
population = 120000
exported_goods = Array[ExtResource("cs")]([ExtResource("c_ore"), ExtResource("c_rare_isotopes"), ExtResource("c_water")])
imported_goods = Array[ExtResource("cs")]([ExtResource("c_food"), ExtResource("c_fuel"), ExtResource("c_medical_supplies"), ExtResource("c_luxury_goods")])
size = 600.0
outfitter_upgrades = Array[ExtResource("uds")]([ExtResource("up_cargo_bay"), ExtResource("up_engine_1"), ExtResource("up_engine_2"), ExtResource("up_engine_3")])
outfitter_weapons = Array[ExtResource("wds")]([ExtResource("w_light_blaster"), ExtResource("w_ion_repeater"), ExtResource("w_pulse_cannon")])
economy_profile = ExtResource("profile")
