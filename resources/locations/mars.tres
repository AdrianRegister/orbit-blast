[ext_resource type="Resource" path="res://resources/commodities/luxury_goods.tres" id="c_luxury_goods"]
[ext_resource type="Script" path="res://scripts/resources/commodity.gd" id="cs"]
[ext_resource type="Resource" path="res://resources/markets/mars_market.tres" id="market"]
[ext_resource type="Resource" path="res://resources/contracts/mars_ore_to_earth.tres" id="co_0"]
[ext_resource type="Resource" path="res://resources/contracts/mars_ore_to_victory.tres" id="co_1"]
[ext_resource type="Script" path="res://scripts/resources/contract_offer.gd" id="cos"]
