[gd_resource type="Resource" script_class="InhabitedData" format=3]

[ext_resource type="Script" path="res://scripts/resources/inhabited_data.gd" id="1"]
[ext_resource type="Resource" path="res://resources/factions/federation.tres" id="faction_1"]
[ext_resource type="Script" path="res://scripts/resources/commodity.gd" id="cs"]
[ext_resource type="Resource" path="res://resources/commodities/industrial_chemicals.tres" id="c_industrial_chemicals"]
[ext_resource type="Resource" path="res://resources/commodities/food.tres" id="c_food"]
[ext_resource type="Resource" path="res://resources/markets/generated/hestia_port_market.tres" id="market"]
[ext_resource type="Script" path="res://scripts/resources/upgrade_definition.gd" id="uds"]
[ext_resource type="Resource" path="res://resources/upgrades/cargo_bay.tres" id="up_cargo_bay"]
[ext_resource type="Resource" path="res://resources/upgrades/engine_1.tres" id="up_engine_1"]

[resource]
script = ExtResource("1")
id = &"hestia_port"
display_name = "Hestia Port"
faction = ExtResource("faction_1")
population = 519900
exported_goods = Array[ExtResource("cs")]([ExtResource("c_industrial_chemicals")])
imported_goods = Array[ExtResource("cs")]([ExtResource("c_food")])
size = 180.0
market = ExtResource("market")
outfitter_upgrades = Array[ExtResource("uds")]([ExtResource("up_cargo_bay"), ExtResource("up_engine_1")])
