[gd_resource type="Resource" script_class="InhabitedData" format=3]

[ext_resource type="Script" path="res://scripts/resources/inhabited_data.gd" id="1"]
[ext_resource type="Resource" path="res://resources/factions/federation.tres" id="faction_1"]
[ext_resource type="Script" path="res://scripts/resources/commodity.gd" id="cs"]
[ext_resource type="Resource" path="res://resources/commodities/fuel.tres" id="c_fuel"]
[ext_resource type="Resource" path="res://resources/commodities/water.tres" id="c_water"]
[ext_resource type="Resource" path="res://resources/commodities/medical_supplies.tres" id="c_medical_supplies"]
[ext_resource type="Resource" path="res://resources/markets/generated/dido_gate_market.tres" id="market"]

[resource]
script = ExtResource("1")
id = &"dido_gate"
display_name = "Dido Gate"
faction = ExtResource("faction_1")
population = 3500
exported_goods = Array[ExtResource("cs")]([ExtResource("c_fuel")])
imported_goods = Array[ExtResource("cs")]([ExtResource("c_water"), ExtResource("c_medical_supplies")])
size = 180.0
market = ExtResource("market")
