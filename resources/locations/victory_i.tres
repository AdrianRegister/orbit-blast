[resource]
script = ExtResource("1")
id = &"victory_i"
display_name = "Victory I"
faction = ExtResource("faction_1")
population = 4500
exported_goods = Array[ExtResource("cs")]([ExtResource("c_fuel"), ExtResource("c_industrial_chemicals")])
imported_goods = Array[ExtResource("cs")]([ExtResource("c_electronics"), ExtResource("c_machinery"), ExtResource("c_water"), ExtResource("c_luxury_goods")])
size = 180.0
shipyard_ships = Array[ExtResource("sss")]([ExtResource("sy_interceptor"), ExtResource("sy_shuttle"), ExtResource("sy_light_frigate")])
outfitter_upgrades = Array[ExtResource("uds")]([ExtResource("up_manoeuvre_1"), ExtResource("up_manoeuvre_2"), ExtResource("up_cargo_bay")])
outfitter_weapons = Array[ExtResource("wds")]([ExtResource("w_light_blaster"), ExtResource("w_ion_repeater"), ExtResource("w_pulse_cannon"), ExtResource("w_heavy_blaster")])
