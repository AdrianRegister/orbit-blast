[gd_resource type="Resource" script_class="ExplorationOffer" format=3]

[ext_resource type="Script" path="res://scripts/resources/exploration_offer.gd" id="1"]

[resource]
script = ExtResource("1")
title = "Chart the Wolf 359 system"
description = "Nobody has flown a survey of Wolf 359, one jump past Barnard's Star. Fly close to every body in the system, the planet and the gas giant both, and report back the findings. The planet is said to be hostile. Do not land."
target_system = &"wolf_359"
reward = 0
