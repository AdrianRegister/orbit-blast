[gd_resource type="Resource" script_class="FormationRecipe" format=3]

[ext_resource type="Script" path="res://scripts/fleet/formation_recipe.gd" id="1"]
[ext_resource type="Script" path="res://scripts/fleet/recipe_group.gd" id="2"]
[ext_resource type="Script" path="res://scripts/resources/ship_class.gd" id="3"]
[ext_resource type="Script" path="res://scripts/fleet/formation_shape.gd" id="4"]
[ext_resource type="Resource" path="res://resources/ship_classes/fighter.tres" id="fighter"]
[ext_resource type="Resource" path="res://resources/ship_classes/heavy_fighter.tres" id="heavy_fighter"]
[ext_resource type="Resource" path="res://resources/ship_classes/gunboat.tres" id="gunboat"]
[ext_resource type="Resource" path="res://resources/ship_classes/corvette.tres" id="corvette"]
[ext_resource type="Resource" path="res://resources/ship_classes/frigate.tres" id="frigate"]
[ext_resource type="Resource" path="res://resources/formations/shapes/wedge.tres" id="wedge"]
[ext_resource type="Resource" path="res://resources/formations/shapes/line.tres" id="line"]
[ext_resource type="Resource" path="res://resources/formations/shapes/diamond.tres" id="diamond"]

[sub_resource type="Resource" id="core"]
script = ExtResource("2")
label = "fighters"
classes = Array[ExtResource("3")]([ExtResource("fighter"), ExtResource("heavy_fighter")])
weights = Array[float]([2.0, 1.0])
min_count = 3
max_count = 6
category = 2
faction_rule = 0

[sub_resource type="Resource" id="support"]
script = ExtResource("2")
label = "support ship"
classes = Array[ExtResource("3")]([ExtResource("gunboat"), ExtResource("corvette"), ExtResource("frigate")])
weights = Array[float]([1.0, 1.0, 1.0])
min_count = 0
max_count = 1
category = 2
faction_rule = 0

[resource]
script = ExtResource("1")
id = &"squadron"
display_name = "Squadron"
description = "3 to 6 ships: fighters and heavy fighters in a 2:1 ratio, with at most one gunboat, corvette or frigate among them."
unit = 0
groups = Array[ExtResource("2")]([SubResource("core"), SubResource("support")])
min_ships = 3
max_ships = 6
shapes = Array[ExtResource("4")]([ExtResource("wedge"), ExtResource("line"), ExtResource("diamond")])
