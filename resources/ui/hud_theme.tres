[resource]
default_font = SubResource("font")
Button/colors/font_color = Color(0.72, 0.77, 0.83, 1)
Button/colors/font_hover_color = Color(0.9, 0.93, 0.97, 1)
Button/colors/font_pressed_color = Color(0.9, 0.93, 0.97, 1)
