[ext_resource type="Script" path="res://scripts/resources/faction.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"faction_1"
display_name = "Federation"
primary_colour = Color(0.753, 0.565, 0.22, 1)
secondary_colour = Color(1, 1, 1, 1)
description = "The core government of the known galaxy: a union of worlds bound by trade and a common defence."
political_identity = "A broadly republican union. Member worlds govern themselves and send delegates to a shared assembly, and what holds the Federation together is common trade and common military interests rather than loyalty to any one world or leader."
background = "The Federation is a complex political entity. Its member worlds, trading houses and military commands each pursue their own ends, and its internal politics are tangled and sometimes dangerous: alliances shift, favours are called in, and those who misjudge them rarely get a second chance."
military_strength = 1000
capital_system = &"sol"
